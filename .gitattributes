# Auto detect text files and perform LF normalization
* text=auto

# JS/JSX files
*.js text
*.jsx text

# JSON files
*.json text

# Documentation
*.md text
*.txt text

# Configs
*.yml text
*.yaml text
*.toml text
*.env text

# Graphics
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Exclude files from exporting
.gitattributes export-ignore
.gitignore export-ignore 